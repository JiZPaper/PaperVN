        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인되면 번역문이 VNDB-Description-Translations 프로젝트에 추가되어 PaperVN 앱에서 사용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
