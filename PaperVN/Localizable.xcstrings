    "开发者太懒了还没有准备今天的Today内容～" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Entwickler war zu faul, die heutigen Today-Inhalte vorzubereiten～"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The developer hasn’t gotten around to preparing today’s content yet～"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発者が怠けて、今日のTodayコンテンツをまだ用意していません～"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개발자가 너무 게을러서 오늘의 Today 콘텐츠를 아직 준비하지 않았습니다~"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
