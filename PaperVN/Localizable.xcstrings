          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開發者太懶了，還沒有準備今天的Today內容～"
          }
        }
      }
    },
    "开发者对你的反馈做出了回复。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Entwickler hat auf dein Feedback geantwortet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The developer replied to your feedback."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
