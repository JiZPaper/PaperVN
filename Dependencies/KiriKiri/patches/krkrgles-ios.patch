-  updateScissorBox();
-  // モジュール(Emote/Live2D 等)が直接描画する場合に備えて即時適用もしておく
-  if (mContext) {
-    glEnable(GL_SCISSOR_TEST);
-    glScissor(mScissorBox[0], mScissorBox[1], mScissorBox[2], mScissorBox[3]);
-  }
