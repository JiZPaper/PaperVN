+static tjs_error eval(IReader &file, tTJSVariant *result)
+{
+	tjs_error ret = TJS_S_OK;
+	if (result) {
+		file.parse(*result);
+	}
+	file.close();
+	if (file.isError) {
+		TVPThrowExceptionMessage(TJS_W("JSONファイル のパースに失敗しました"));
+	}
+	return ret;
+}
