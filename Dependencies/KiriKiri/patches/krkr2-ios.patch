+static void TVPRippleTransform_emmx_f(
+	const tjs_uint16 *displacemap, const tjs_uint16 *driftmap, tjs_uint32 *dest,
+	tjs_int num, tjs_int pitch, const tjs_uint8 * src1, const tjs_uint8 * src2, tjs_int ratio)
+{
+	_asm
+	{
+		mov			esi,			driftmap
+		mov			edi,			dest
+		xor			ebx,			ebx
+		mov			ecx,			displacemap
+		movd		mm7,			ratio
+		psllq		mm7,			7
+		punpcklwd	mm7,			mm7
+		punpcklwd	mm7,			mm7
+		pxor		mm0,			mm0
+
+		sub			num,			1
