+/**
+ * 現在の状態の通知
+ * @param percent パーセント
+ */
+bool
+SaveInfo::progress(int percent)
+{
+	if ((int)progressPercent != percent) {
+		progressPercent = percent;
+		if (notify) {
+			notify->postMessage(WM_SAVE_TLG_PROGRESS, (tjs_uint64)(tjs_intptr_t)this);
+			std::this_thread::yield();
+		}
+	}
+	return canceled;
+}
