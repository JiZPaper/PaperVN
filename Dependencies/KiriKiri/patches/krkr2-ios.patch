+static tjs_error TJS_INTF_METHOD
+GetCropRectZero(tTJSVariant *result, tjs_int numparams, tTJSVariant **param, iTJSDispatch2 *lay)
+{
+	// レイヤバッファの取得
+	BufRefT p, r = 0;
