+++ b/cpp/plugins/shrinkCopy/readme.txt
@@ -0,0 +1,22 @@
+Title: shrinkCopy プラグイン
+Author: miahmie
+
+●これは何か？
+
+面積平均法※アルゴリズムによる縮小専用コピーメソッドがLayerに追加されます。
+1/2以下の縮小でstretchCopy/affineCopyより高品質に縮小できるかと思います。
+描画速度は割と遅いので，リアルタイムの描画用途には向きません。
+ツール用途やセーブのサムネイル生成用途など推奨です。
+
+※高速化のために1/256pxを分解能としているので厳密な面積平均法ではありません。
+
+
+●使い方
+
+manual.tjs を参照してください。
+
+
+●ライセンス
+
+このプラグインのライセンスは吉里吉里本体に準拠してください。
+
diff --git a/cpp/plugins/systemEx/PaperVNMain.cpp b/cpp/plugins/systemEx/PaperVNMain.cpp
new file mode 100644
index 0000000..e3905b5
--- /dev/null
+++ b/cpp/plugins/systemEx/PaperVNMain.cpp
@@ -0,0 +1,98 @@
+// PaperVN：systemEx.dll 的 iOS 实现（接口见 manual.tjs，来自 wamsoft/systemEx）。
+// 原版几乎全是 Windows API。环境变量、URL 编码能照常工作；注册表、DLL 目录这些 iOS 没有的返回空，
+// 只是让调用它们的脚本不报错。
+#include "tp_stub.h"
+#include "ncbind.hpp"
+#include <cstdlib>
+#include <cctype>
+#include <string>
+
+namespace {
+std::string narrow(const tTJSVariant &value) { return ttstr(value).AsStdString(); }
+
+tjs_error readEnv(tTJSVariant *r, tjs_int n, tTJSVariant **p, iTJSDispatch2 *) {
+    if(n < 1) return TJS_E_BADPARAMCOUNT;
+    const char *value = getenv(narrow(*p[0]).c_str());
+    if(r) *r = value ? tTJSVariant(ttstr(value)) : tTJSVariant();
+    return TJS_S_OK;
+}
+tjs_error writeEnv(tTJSVariant *r, tjs_int n, tTJSVariant **p, iTJSDispatch2 *) {
+    if(n < 2) return TJS_E_BADPARAMCOUNT;
+    setenv(narrow(*p[0]).c_str(), narrow(*p[1]).c_str(), 1);
+    if(r) *r = tTJSVariant((tjs_int)1);
+    return TJS_S_OK;
+}
+tjs_error expandEnv(tTJSVariant *r, tjs_int n, tTJSVariant **p, iTJSDispatch2 *) {
+    if(n < 1) return TJS_E_BADPARAMCOUNT;
+    const std::string src = narrow(*p[0]);
+    std::string out;
+    for(size_t i = 0; i < src.size();) {
+        size_t end = src[i] == '%' ? src.find('%', i + 1) : std::string::npos;
+        if(end != std::string::npos) {
+            const char *value = getenv(src.substr(i + 1, end - i - 1).c_str());
+            if(value) { out += value; i = end + 1; continue; }
+        }
+        out += src[i++];
+    }
+    if(r) *r = tTJSVariant(ttstr(out));
+    return TJS_S_OK;
+}
+tjs_error urlEncode(tTJSVariant *r, tjs_int n, tTJSVariant **p, iTJSDispatch2 *) {
+    if(n < 1) return TJS_E_BADPARAMCOUNT;
+    static const char hex[] = "0123456789ABCDEF";
+    std::string out;
+    for(unsigned char c : narrow(*p[0])) {
+        if(isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~') out += (char)c;
+        else { out += '%'; out += hex[c >> 4]; out += hex[c & 15]; }
+    }
+    if(r) *r = tTJSVariant(ttstr(out));
+    return TJS_S_OK;
+}
+tjs_error urlDecode(tTJSVariant *r, tjs_int n, tTJSVariant **p, iTJSDispatch2 *) {
+    if(n < 1) return TJS_E_BADPARAMCOUNT;
+    const std::string src = narrow(*p[0]);
+    std::string out;
+    for(size_t i = 0; i < src.size(); ++i) {
+        if(src[i] == '%' && i + 2 < src.size() && isxdigit((unsigned char)src[i + 1]) && isxdigit((unsigned char)src[i + 2])) {
+            out += (char)strtol(src.substr(i + 1, 2).c_str(), nullptr, 16);
+            i += 2;
+        } else if(src[i] == '+') out += ' ';
+        else out += src[i];
+    }
+    if(r) *r = tTJSVariant(ttstr(out));
+    return TJS_S_OK;
+}
+tjs_error returnVoid(tTJSVariant *r, tjs_int, tTJSVariant **, iTJSDispatch2 *) {
+    if(r) r->Clear();
+    return TJS_S_OK;
+}
+tjs_error returnTrue(tTJSVariant *r, tjs_int, tTJSVariant **, iTJSDispatch2 *) {
+    if(r) *r = tTJSVariant((tjs_int)1);
+    return TJS_S_OK;
+}
+tjs_error aboutString(tTJSVariant *r, tjs_int, tTJSVariant **, iTJSDispatch2 *) {
+    if(r) *r = tTJSVariant(ttstr(TJS_W("PaperVN")));
+    return TJS_S_OK;
+}
+struct SystemEx {};
+} // namespace
+
+NCB_ATTACH_CLASS(SystemEx, System) {
+    RawCallback(TJS_W("readEnvValue"), &readEnv, TJS_STATICMEMBER);
+    RawCallback(TJS_W("writeEnvValue"), &writeEnv, TJS_STATICMEMBER);
+    RawCallback(TJS_W("expandEnvString"), &expandEnv, TJS_STATICMEMBER);
+    RawCallback(TJS_W("urlencode"), &urlEncode, TJS_STATICMEMBER);
+    RawCallback(TJS_W("urldecode"), &urlDecode, TJS_STATICMEMBER);
+    RawCallback(TJS_W("getAboutString"), &aboutString, TJS_STATICMEMBER);
+    RawCallback(TJS_W("readRegValue"), &returnVoid, TJS_STATICMEMBER);
+    RawCallback(TJS_W("writeRegValue"), &returnVoid, TJS_STATICMEMBER);
+    RawCallback(TJS_W("waitForAppLock"), &returnTrue, TJS_STATICMEMBER);
+    RawCallback(TJS_W("setDpiAwareness"), &returnVoid, TJS_STATICMEMBER);
+    RawCallback(TJS_W("getOSVersion"), &returnVoid, TJS_STATICMEMBER);
+    RawCallback(TJS_W("getKnownFolderPath"), &returnVoid, TJS_STATICMEMBER);
+    RawCallback(TJS_W("processApplicationMessages"), &returnVoid, TJS_STATICMEMBER);
+    RawCallback(TJS_W("handleApplicationMessage"), &returnVoid, TJS_STATICMEMBER);
+    RawCallback(TJS_W("setDefaultDllDirectories"), &returnVoid, TJS_STATICMEMBER);
+    RawCallback(TJS_W("addDllDirectory"), &returnVoid, TJS_STATICMEMBER);
+    RawCallback(TJS_W("removeDllDirectory"), &returnVoid, TJS_STATICMEMBER);
+}
