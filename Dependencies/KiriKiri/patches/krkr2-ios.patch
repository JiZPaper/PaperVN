+//---------------------------------------------------------------------------
+/*
+	切り替え元、切り替え先の画像をクルクル回す系のトランジション用の基底クラス
+	の実装
+*/
+//---------------------------------------------------------------------------
+tTVPBaseRotateTransHandler::tTVPBaseRotateTransHandler(tjs_uint64 time,
+	tjs_int width, tjs_int height, tjs_uint32 bgcolor)
+{
+	RefCount = 1;
+	Width = width;
+	Height = height;
