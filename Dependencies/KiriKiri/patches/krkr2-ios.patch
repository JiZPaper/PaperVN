 static std::string G_DefaultReadEncoding = "UTF-8";
 
+static bool isValidUTF8(const unsigned char *p, size_t size) {
+    size_t i = 0;
+    while(i < size) {
+        unsigned char c = p[i];
+        size_t n;
+        if(c < 0x80) {
+            i++;
+            continue;
+        } else if((c & 0xE0) == 0xC0 && c >= 0xC2) {
+            n = 1;
+        } else if((c & 0xF0) == 0xE0) {
+            n = 2;
+        } else if((c & 0xF8) == 0xF0 && c <= 0xF4) {
+            n = 3;
+        } else {
+            return false;
+        }
+        for(size_t k = 1; k <= n; k++) {
+            if(i + k >= size || (p[i + k] & 0xC0) != 0x80)
+                return false;
+        }
+        i += n + 1;
+    }
+    return true;
+}
