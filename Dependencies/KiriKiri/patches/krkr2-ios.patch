+void tTVPApplication::PaperVNShutdown() {
+    // 剧本、图像等缓存的键是游戏里的路径，不留给下一部游戏
+    try {
+        TVPDeliverCompactEvent(TVP_COMPACT_LEVEL_MAX);
+    } catch(...) {
+    }
+    // 窗口的 finalize 会让 KAG 释放声音、图层、计时器；循环引用靠清空全局对象解不开
+    for(tjs_int i = TVPGetWindowCount() - 1; i >= 0; --i) {
+        try {
+            iTJSDispatch2 *owner = TVPGetWindowListAt(i)->GetOwnerNoAddRef();
+            if(owner)
+                owner->Invalidate(0, nullptr, nullptr, owner);
+        } catch(...) {
+            // 游戏脚本的错误不影响退出
+        }
+    }
+    // finalize 出错时窗口还留在列表里：直接让原生窗口失效，它不会再访问已销毁的画面
+    for(tjs_int i = TVPGetWindowCount() - 1; i >= 0; --i) {
+        try {
+            TVPGetWindowListAt(i)->Invalidate();
+        } catch(...) {
+        }
+        if(i > TVPGetWindowCount())
+            i = TVPGetWindowCount();
+    }
+    TVPPaperVNResetWindowList();
+    TVPPaperVNReleaseWindowMenus();
+    TVPPaperVNStopAllSounds();
+    delete image_load_thread_;
+    image_load_thread_ = nullptr;
+    delete TVPSystemControl;
+    TVPSystemControl = nullptr;
+    _project_startup = false;
+    try {
+        TVPSystemUninit();
+    } catch(...) {
+    }
+    ncbAutoRegister::PaperVNResetModules();
+    TVPPaperVNResetStorage();
+    TVPPaperVNResetWindowList(); // 上面的清理过程中也可能再创建窗口
+    tarminate_ = false;
+    // 这些消息和回调指向上一部游戏的对象，留着下一部游戏启动时会访问已释放的内存
+    {
+        std::lock_guard<std::mutex> cs(m_msgQueueLock);
+        m_lstUserMsg.clear();
+    }
+    m_activeEvents.clear();
+    TVPPaperVNResetSystemFlags();
+    TVPPaperVNResetScriptEngineFlags();
+    TVPPaperVNResetSysInit();
+    TVPPaperVNResetFontNames();
+    TVPPaperVNResetAppTitle();
+}
